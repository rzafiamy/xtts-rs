# Environment for `xtts serve` / `speak` (copy to .env or export).
# Command-line options take precedence over these variables.
# No secret is needed: the model is a local file.

# GGUF model file (from `xtts convert`) or a Coqui checkpoint directory
XTTS_MODEL=models/xtts-v2-q4k.gguf
# auto (CUDA if available), cpu, cuda, cuda:1, metal
XTTS_DEVICE=auto
# CPU threads (default: all cores)
# XTTS_THREADS=8
# Server
XTTS_HOST=127.0.0.1
XTTS_PORT=8091
XTTS_VOICE="Claribel Dervla"
XTTS_LANG=fr
# Log level
RUST_LOG=info
